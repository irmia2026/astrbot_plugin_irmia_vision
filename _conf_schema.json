{
  "VL 模型配置": {
    "description": "配置视觉语言模型（VL）。从 AstrBot 已保存的模型中按优先级选择，第一个不可用时自动降级到下一个。全部留空则自动使用所有已保存模型。修改后重载插件生效。",
    "type": "object",
    "items": {
      "vl_provider_1": {
        "description": "首选 VL 模型",
        "hint": "从 AstrBot 已保存的模型中选择。留空则自动使用全部。",
        "type": "string",
        "default": ""
      },
      "vl_provider_2": {
        "description": "次选 VL 模型（首选不可用时降级）",
        "hint": "留空则跳过。",
        "type": "string",
        "default": ""
      },
      "vl_provider_3": {
        "description": "再次选 VL 模型（次选也不可用时降级）",
        "hint": "留空则跳过。",
        "type": "string",
        "default": ""
      },
      "vl_provider_ids": {
        "description": "高级：手动填写模型 ID（逗号分隔，按降级顺序）。填写后覆盖上方三个下拉框。",
        "hint": "一般不需要填。留空则使用上方下拉框的选择。",
        "type": "string",
        "default": ""
      },
      "vl_model": {
        "description": "手动 VL 模型连接参数（当以上所有配置均为空时生效）",
        "type": "object",
        "items": {
          "provider": {
            "description": "模型提供商（openai / azure / 自定义）",
            "type": "string",
            "default": "openai"
          },
          "base_url": {
            "description": "API 地址，支持 OpenAI 兼容 API（如 https://api.openai.com/v1）",
            "hint": "例如 https://api.openai.com/v1",
            "type": "string",
            "default": "https://api.openai.com/v1"
          },
          "api_key": {
            "description": "API 密钥",
            "type": "string",
            "default": ""
          },
          "model": {
            "description": "模型名称（如 gpt-4o、gpt-4o-mini、claude-3-5-sonnet）",
            "type": "string",
            "default": "gpt-4o"
          },
          "timeout": {
            "description": "请求超时时间（秒）",
            "type": "float",
            "default": 120.0
          },
          "concurrency": {
            "description": "最大并发请求数",
            "type": "int",
            "default": 50
          },
          "max_retries": {
            "description": "最大重试次数",
            "type": "int",
            "default": 2
          }
        }
      }
    }
  }
}
